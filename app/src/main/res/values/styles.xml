<resources>

    <style name="Base.Theme.ICT2_Project." parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Popup menu background color -->
        <item name="android:popupMenuStyle">@style/CustomPopupMenu</item>
        <!-- Popup menu text color & size -->
        <item name="android:textAppearanceLargePopupMenu">@style/CustomMenuText</item>
    </style>

    <style name="CustomPopupMenu" parent="@style/Widget.MaterialComponents.PopupMenu">
        <item name="android:background">@color/cardLightBg</item>
    </style>

    <style name="CustomMenuText" parent="@android:style/TextAppearance.Large">
        <item name="android:textColor">#1E3A8A</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CustomTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="android:textColorHint">#1E3A8A</item>
        <item name="hintTextColor">#1E3A8A</item>
        <item name="boxStrokeColor">#1E3A8A</item>
    </style>
</resources>
<resources>

    <style name="Base.Theme.ICT2_Project." parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:popupMenuStyle">@style/CustomPopupMenu</item>
        <item name="android:textAppearanceLargePopupMenu">@style/CustomMenuText</item>
    </style>

    <style name="CustomPopupMenu" parent="@style/Widget.MaterialComponents.PopupMenu">
        <item name="android:background">@color/cardLightBg</item>
    </style>

    <style name="CustomMenuText" parent="@android:style/TextAppearance.Large">
        <item name="android:textColor">@color/accent_blue</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CustomTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="hintTextColor">@color/text_hint</item>
        <item name="boxStrokeColor">@color/input_stroke_color</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="endIconTint">@color/primary</item>
        <item name="endIconMinSize">24dp</item>
    </style>

    <style name="AppFilterDropdown">
        <item name="android:background">@null</item>
        <item name="android:focusable">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="AppToolbarTitle">
        <item name="android:textColor">@color/toolbar_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppToolbarSubtitle">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="FilterLabel">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppSectionTitle">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ========== BUTTON STYLES - SIRF EK BAAR DEFINE KARO ========== -->

    <!-- Primary Button Style - SIRF EK BAAR (Duplicate hata diya) -->
    <style name="AppButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="AppCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/cardLightBg</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Success Button Style (Green) -->
    <style name="AppButtonSuccess" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/present_green</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Danger Button Style (Red) -->
    <style name="AppButtonDanger" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/absent_red</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

</resources>